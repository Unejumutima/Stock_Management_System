# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zubahouse_stock
DB_USER=postgres
DB_PASSWORD=ikirezi

# JWT (use a long random string in production)
JWT_SECRET=change_this_to_a_secure_random_string
JWT_EXPIRES_IN=7d

# CORS — React dev server URL
CLIENT_URL=http://localhost:5173

# Google OAuth — get these from https://console.cloud.google.com/
# Create an OAuth 2.0 Client ID, set redirect URI to http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
